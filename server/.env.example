# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Local:      postgresql://postgres:password@localhost:5432/collaboard
# Supabase:   postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Railway:    Provided in Railway dashboard under "Connect"
DATABASE_URL=postgresql://postgres:password@localhost:5432/collaboard

# ── Redis ──────────────────────────────────────────────────────────────────────
# Local:   redis://localhost:6379
# Upstash: rediss://:[token]@[endpoint].upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# CORS — set to your Vercel URL in production
ALLOWED_ORIGIN=http://localhost:5173

# ── Room GC ────────────────────────────────────────────────────────────────────
# Rooms inactive longer than this (in days) will be deleted by the nightly cron
ROOM_TTL_DAYS=7
