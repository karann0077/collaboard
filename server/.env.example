# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Production: copy the exact Supabase Session Pooler URL from Supabase → Connect.
# Example shape: postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/collaboard

# ── Redis ──────────────────────────────────────────────────────────────────────
# Local:   redis://localhost:6379
# Upstash: rediss://:[token]@[endpoint].upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Required in production. Use a long random value and never commit it.
SESSION_SECRET=replace-with-a-long-random-secret

# CORS + CSRF — set this to the exact Vercel frontend origin in production.
ALLOWED_ORIGIN=http://localhost:5173

# Snapshot configuration
SNAPSHOT_INTERVAL=500

# ── Room GC ────────────────────────────────────────────────────────────────────
# Rooms inactive longer than this (in days) will be deleted by the nightly cron.
ROOM_TTL_DAYS=7
